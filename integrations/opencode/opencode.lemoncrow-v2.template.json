{
  "permissions": [
    {"action": "lc_*", "resource": "*", "effect": "allow"}
  ],
  "mcp": {
    "servers": {
      "lc": {
        "type": "local",
        "codemode": false,
        "command": ["lemoncrow", "runtime", "lite-mcp", "--host", "opencode"],
        "environment": {
          "LEMONCROW_WORKSPACE_ROOT": "<WORKSPACE_ROOT>"
        }
      }
    }
  }
}
