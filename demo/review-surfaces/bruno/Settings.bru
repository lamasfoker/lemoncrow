meta {
  name: Workspace settings
  type: http
  seq: 6
}

get {
  url: {{baseUrl}}/api/settings
  body: none
  auth: none
}

tests {
  test("keeps previews offline and bounded", function() {
    expect(res.status).to.equal(200);
    expect(res.body.network).to.equal(false);
    expect(res.body.preview_timeout_seconds).to.equal(120);
  });
}
